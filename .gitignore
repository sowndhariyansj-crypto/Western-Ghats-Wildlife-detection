# ============================================================
# .gitignore — Animal Detection project
# Keeps datasets, weights, logs, and generated outputs out
# of version control.
# ============================================================

# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
*.spec

# ─── Virtual environments ─────────────────────────────────────────
venv/
.venv/
env/
ENV/
.conda/

# ─── Dataset images and labels ───────────────────────────────────
# Add your own images locally; do not commit them.
data/images/
data/labels/

# ─── Dataset split files (generated by split_dataset.py) ─────────
data/train/
data/val/
data/test/

# ─── Model weights ───────────────────────────────────────────────
# Weights can be large (>100 MB). Store separately (e.g., cloud storage).
weights/
*.pt
*.pth
*.onnx
*.tflite
*.engine
*.torchscript
*.mlmodel
*.pb
*.h5

# ─── Training runs (Ultralytics output) ──────────────────────────
runs/

# ─── Evaluation and app outputs ──────────────────────────────────
results/
output/
outputs/

# ─── Generated video / image outputs (infer.py, app.py) ──────────
*.mp4
*.avi
*.mov
*.mkv
*.gif
# (keep committed source images; only exclude inferred outputs)
*_annotated.jpg
*_annotated.png
*_output.jpg
*_output.png

# ─── Logs ────────────────────────────────────────────────────────
logs/
*.log

# ─── Temporary files ─────────────────────────────────────────────
*.tmp
*.bak
*.swpx
tmp/
temp/
.cache/

# ─── IDE / Editor ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Streamlit cache & secrets ────────────────────────────────────
.streamlit/
# Allow the shared config but ignore secrets
!.streamlit/config.toml
.streamlit/secrets.toml

# ─── Jupyter Notebooks (if used) ─────────────────────────────────
.ipynb_checkpoints/

# ─── Testing & coverage ───────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ─── Build / packaging artefacts ─────────────────────────────────
*.whl
*.tar.gz
MANIFEST

# ─── Environment variables / secrets ─────────────────────────────
.env
.env.*
*.env
secrets.yaml
secrets.yml

# ─── Make / Sphinx docs build ─────────────────────────────────────
make.bat.bak
docs/_build/

# ─── Keep placeholder files in tracked folders ───────────────────
!data/images/**/.gitkeep
!data/labels/**/.gitkeep
!data/train/**/.gitkeep
!data/val/**/.gitkeep
!data/test/**/.gitkeep
!weights/.gitkeep
!logs/.gitkeep
!results/.gitkeep
